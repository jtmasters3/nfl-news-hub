    "test:codex-outcome": "node scripts/social-worker/lib/codexOutcome.test.mjs",
    "test:source-image": "node scripts/social-worker/lib/sourceImage.test.mjs",
    "test:generate-retries": "node scripts/social-worker/lib/generateWithRetries.test.mjs",
